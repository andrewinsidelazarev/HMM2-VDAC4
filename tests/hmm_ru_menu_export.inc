// Native resource preparation only; not linked into the ESP module.
// Artwork is generated by image_gen, then indexed by tools/import_menu_art.py.
#include "image_palette.h"
static fheroes2::Sprite hmm_russian_menu_sprite(const fheroes2::Sprite &source,unsigned frame){
    fheroes2::Sprite result=source;
    if(frame>=20)return result;
    struct Art { uint32_t head[6];std::vector<uint8_t> pixels; };
    static std::vector<Art> art;
    auto fnv=[](const uint8_t *p,size_t n,uint32_t hash=2166136261u){while(n--)hash=(hash^*p++)*16777619u;return hash;};
    if(art.empty()){
        const char *path=std::getenv("HMM2_MENU_ART");FILE *file=path?std::fopen(path,"rb"):nullptr;
        if(!file)throw std::runtime_error("Generated menu artwork is missing");
        uint32_t head[4];bool ok=std::fread(head,1,sizeof(head),file)==sizeof(head);
        ok=ok&&head[0]==0x314e4d48&&head[1]==1&&head[2]==20&&head[3]==fnv(fheroes2::getGamePalette(),768);
        std::vector<Art> loaded(ok?20:0);
        for(auto &a:loaded){
            ok=ok&&std::fread(a.head,1,sizeof(a.head),file)==sizeof(a.head);
            if(!ok||a.head[0]>128||a.head[1]>128||a.head[4]!=0){ok=false;break;}
            a.pixels.resize(a.head[0]*a.head[1]);
            ok=std::fread(a.pixels.data(),1,a.pixels.size(),file)==a.pixels.size();if(!ok)break;
        }
        ok=ok&&std::fgetc(file)==EOF;std::fclose(file);
        if(!ok)throw std::runtime_error("Invalid generated menu artwork");
        art=std::move(loaded);
    }
    const auto &a=art[frame];const auto n=size_t(source.width())*source.height();
    if(a.head[0]!=unsigned(source.width())||a.head[1]!=unsigned(source.height())||
       int32_t(a.head[2])!=source.x()||int32_t(a.head[3])!=source.y()||source.singleLayer()||
       a.head[5]!=fnv(source.transform(),n,fnv(source.image(),n)))
        throw std::runtime_error("Original menu sprite does not match generated artwork");
    std::copy(a.pixels.begin(),a.pixels.end(),result.image());
    return result;
}
